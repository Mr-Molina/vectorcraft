@@ -245,10 +245,77 @@ pub fn stroke_options(st: &StrokeLayer) -> Value {
 #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
 pub struct StrokeMixed {
     pub weight: bool,
     pub cap: bool,
     pub join: bool,
     pub miter_limit: bool,
     pub align: bool,
     pub dash: bool,
     pub can_align: bool,
 }
